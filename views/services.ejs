<%- include('partials/head') %>
<%- include('partials/header') %>
<%- include('partials/crumbs') %>

<section class="phero shot">
  <div class="phero-img"><img src="<%= img.data %>" alt=""></div>
  <div class="wrap">
    <div class="eyebrow">Service catalog</div>
    <h1>Everything we<br>build and send</h1>
    <p class="lede">Four layers: core merchant data, adjacent financing verticals, data services that improve lists you already own, and managed outbound that returns conversations rather than records.</p>
    <div class="acts">
      <a class="btn" href="/book">Scope a pull</a>
      <a class="btn ghost" href="/pricing">How pricing works</a>
    </div>
  </div>
</section>

<% categories.forEach(function(cat, ci){ %>
<section class="section <%= ci % 2 === 1 ? 'alt' : '' %>">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow"><%= cat.name %></div>
      <h2><%= cat.name %></h2>
    </div>
    <div class="grid c3">
      <% cat.services.forEach(function(s, i){ %>
        <a class="card" href="/services/<%= s.slug %>">
          <span class="idx">0<%= i + 1 %></span>
          <h3><%= s.name %></h3>
          <p><%= s.tagline %></p>
          <span class="arrow">Details &rarr;</span>
        </a>
      <% }); %>
    </div>
  </div>
</section>
<% }); %>

<section class="section">
  <div class="wrap">
    <%- include('partials/ctaband', { ctaHead: 'Not sure which layer you need?', ctaLine: 'Describe how you prospect today and we will tell you which piece is actually missing — including when the answer is none of them.' }) %>
  </div>
</section>

<%- include('partials/footer') %>
