<div class="topbar">
  <div class="wrap">
    <div class="tb-left">Verified merchant email data &middot; 50 states + DC &middot; CSV, API, or direct CRM delivery</div>
    <div class="tb-right">
      <a href="tel:<%= site.phoneHref %>"><%= site.phone %></a>
      <a href="mailto:<%= site.email %>"><%= site.email %></a>
    </div>
  </div>
</div>

<header class="site">
  <div class="wrap">
    <a class="brand" href="/">
      <svg width="40" height="40" viewBox="0 0 48 48" aria-hidden="true"><rect width="48" height="48" rx="13" fill="#0E9F6E"/><path d="M11 18.5v13.2c0 1.5 1.2 2.8 2.8 2.8h20.4c1.6 0 2.8-1.3 2.8-2.8V18.5" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M11 18.5 24 27l13-8.5" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" opacity=".55"/><path d="M15.5 20.5 21 15l4.5 4.5L33 12" fill="none" stroke="#FCFAF6" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M27.5 12H33v5.5" fill="none" stroke="#FCFAF6" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span>
        <span class="brand-name"><%= site.name %></span>
        <span class="brand-sub" style="display:block">Merchant data &middot; MCA</span>
      </span>
    </a>

    <nav class="main" id="mainnav">
      <% nav.forEach(function(item){ %>
        <a href="<%= item.href %>" class="<%= path === item.href || path.indexOf(item.href + '/') === 0 ? 'active' : '' %>"><%= item.label %></a>
      <% }); %>
      <a href="/contact" class="<%= path === '/contact' ? 'active' : '' %>">Contact</a>
    </nav>

    <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation" aria-expanded="false">MENU</button>
    <a class="btn sm" href="/book">Book a call</a>
  </div>
</header>
