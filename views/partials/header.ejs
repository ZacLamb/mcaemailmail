<div class="topbar">
  <div class="wrap">
    <div class="tb-left">Verified merchant email data &middot; 50 states + DC &middot; CSV, API, or direct CRM delivery</div>
    <div class="tb-right">
      <a href="tel:<%= site.phoneHref %>"><%= site.phone %></a>
      <a href="mailto:<%= site.email %>"><%= site.email %></a>
    </div>
  </div>
</div>

<header class="site">
  <div class="wrap">
    <a class="brand" href="/">
      <svg width="42" height="42" viewBox="0 0 48 48" aria-hidden="true"><path d="M7 12h34a3 3 0 0 1 3 3v20a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V15a3 3 0 0 1 3-3z" fill="#0E9F6E"/> <path d="M4.6 15.4 24 29 43.4 15.4" fill="none" stroke="#fff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/> <circle cx="37" cy="35" r="10.5" fill="#FFFFFF"/> <circle cx="37" cy="35" r="8.4" fill="#07683F"/> <path d="M33 35.2l2.8 2.8L41.2 32" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span>
        <span class="brand-name"><%= site.name %></span>
        <span class="brand-sub" style="display:block">Merchant data &middot; MCA</span>
      </span>
    </a>

    <nav class="main" id="mainnav">
      <% nav.forEach(function(item){ %>
        <a href="<%= item.href %>" class="<%= path === item.href || path.indexOf(item.href + '/') === 0 ? 'active' : '' %>"><%= item.label %></a>
      <% }); %>
      <a href="/contact" class="<%= path === '/contact' ? 'active' : '' %>">Contact</a>
    </nav>

    <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation" aria-expanded="false">MENU</button>
    <a class="btn sm" href="/book">Book a call</a>
  </div>
</header>
